# ==================================================================
# pharma-oss アプリケーション実行時環境変数設定 (.env.example)
# コードベース内から抽出された全 66 件の実行時設定一覧
# ==================================================================

# ------------------------------------------------------------------
# 1. データベース暗号化キー (RxDB at-rest encryption)
# ------------------------------------------------------------------
# Next.js では NEXT_PUBLIC_ 接頭辞の変数はブラウザに埋め込まれる。
# 本番環境では必ず長いランダム文字列に変更すること(例の値をそのまま使わない)。
# 未設定の場合は端末ごとにランダムな鍵が自動生成されlocalStorageに保存されるが、
# ブラウザプロファイルが消えると復号できなくなるため、本番では明示的に設定し
# 安全な場所に控えておくことを推奨する。
NEXT_PUBLIC_DB_PASSWORD=your-secure-production-db-password-here
NEXT_PUBLIC_SQLITE_WASM_BINARY_URL=
NEXT_PUBLIC_SQLITE_WASM_MODULE_URL=
NEXT_PUBLIC_SQLITE_WASM_SCRIPT_URL=
NEXT_PUBLIC_SQLITE_MASTER_WORKER_URL=

# ------------------------------------------------------------------
# 2. システム基本設定
# ------------------------------------------------------------------
NODE_ENV=development
FAKE_AWS_ROOT=

# ------------------------------------------------------------------
# 3. 外部仕様PDF・データ取得用パラメータ
# ------------------------------------------------------------------
DISPENSING_UKE_OFFICIAL_SPEC_PDF_MAX_BYTES=10485760
DISPENSING_UKE_OFFICIAL_SPEC_PDF_TIMEOUT_MS=15000
DRUG_MASTER_OFFICIAL_FILE_MAX_BYTES=20971520
DRUG_MASTER_OFFICIAL_FILE_TIMEOUT_MS=15000
DRUG_MASTER_OFFICIAL_PAGE_TIMEOUT_MS=10000
DRUG_MASTER_OFFICIAL_SPEC_PDF_MAX_BYTES=10485760
DRUG_MASTER_OFFICIAL_SPEC_PDF_TIMEOUT_MS=15000

# ------------------------------------------------------------------
# 4. 電子処方箋連携 (Electronic Prescription)
# ------------------------------------------------------------------
ELECTRONIC_PRESCRIPTION_MODE=mock
ELECTRONIC_PRESCRIPTION_ENDPOINT=http://127.0.0.1:8080/ep-api
ELECTRONIC_PRESCRIPTION_BEARER_TOKEN=ep-sample-bearer-token
ELECTRONIC_PRESCRIPTION_CAPABILITIES=
ELECTRONIC_PRESCRIPTION_CONNECTOR_ARTIFACT_SHA256=
ELECTRONIC_PRESCRIPTION_CONNECTOR_KIND=
ELECTRONIC_PRESCRIPTION_CSV_MAX_BYTES=5242880
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_AT=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_AUTH_SHA256=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_CAPABILITIES=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_CONNECTOR_ARTIFACT_SHA256=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_CONNECTOR_KIND=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_ENDPOINT_SHA256=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_OUTCOME=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_RESPONSE_SHAPE=
ELECTRONIC_PRESCRIPTION_LAST_ATTEMPT_STATUS_CODE=
ELECTRONIC_PRESCRIPTION_REQUIRED_DISPLAY_ITEMS=
ELECTRONIC_PRESCRIPTION_SHARED_FOLDER_MAX_PENDING_FILES=100
ELECTRONIC_PRESCRIPTION_SHARED_FOLDER_MODE=disabled
ELECTRONIC_PRESCRIPTION_SHARED_FOLDER_PERFORMANCE_P95_MS=
ELECTRONIC_PRESCRIPTION_SHARED_FOLDER_POLL_INTERVAL_MS=3000
ELECTRONIC_PRESCRIPTION_SHARED_FOLDER_RETRY_POLICY_CONFIRMED=
ELECTRONIC_PRESCRIPTION_SHARED_FOLDER_STALE_AFTER_MS=86400000
ELECTRONIC_PRESCRIPTION_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# 5. 調剤機器・ピッキング端末連携 (Pharmacy Device Connector)
# ------------------------------------------------------------------
PHARMACY_DEVICE_CONNECTOR_MODE=mock
PHARMACY_DEVICE_CONNECTOR_ENDPOINT=http://127.0.0.1:8080/device-api
PHARMACY_DEVICE_CONNECTOR_BEARER_TOKEN=device-sample-bearer-token
PHARMACY_DEVICE_CONNECTOR_CAPABILITIES=
PHARMACY_DEVICE_CONNECTOR_FACILITY_LOCAL_ONLY=
PHARMACY_DEVICE_CONNECTOR_INTERFACE_VERSION=
PHARMACY_DEVICE_CONNECTOR_KIND=
PHARMACY_DEVICE_CONNECTOR_LAST_ATTEMPT_OUTCOME=
PHARMACY_DEVICE_CONNECTOR_NSIPS_LICENSE_CONFIRMED=
PHARMACY_DEVICE_CONNECTOR_SIMULATOR_ENABLED=false
PHARMACY_DEVICE_CONNECTOR_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# 6. オンライン資格確認 (Online Eligibility)
# ------------------------------------------------------------------
ONLINE_ELIGIBILITY_MODE=mock
ONLINE_ELIGIBILITY_ENDPOINT=http://127.0.0.1:8080/eligibility-api
ONLINE_ELIGIBILITY_BEARER_TOKEN=eligibility-sample-token
ONLINE_ELIGIBILITY_ALLOW_MOCK=true
ONLINE_ELIGIBILITY_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# 7. マイナンバーカードリーダー (Myna Card Reader)
# ------------------------------------------------------------------
MYNA_CARD_READER_MODE=mock
MYNA_CARD_READER_ENDPOINT=http://127.0.0.1:8080/myna-api
MYNA_CARD_READER_ALLOW_MOCK=true
MYNA_CARD_READER_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# 8. 店舗内複数端末（サテライト端末同期） (Satellite Sync)
# 単独端末で使う場合は設定不要(既定 standalone)。
# 詳しい手順・安全設計は docs/satellite_terminal_sync_plan.md を参照。
# ------------------------------------------------------------------

# --- メイン端末(集約ハブ)の例 ---
# PHARMACY_SYNC_ROLE=hub
PHARMACY_SYNC_ROLE=standalone
PHARMACY_SYNC_HUB_ENDPOINT=
PHARMACY_SYNC_TERMINAL_ID=
PHARMACY_SYNC_TERMINAL_TOKEN=
PHARMACY_SYNC_HUB_DB_PATH=./data/sync_hub.sqlite
# ハブストア(患者データを含む正本SQLite)のat-rest暗号鍵。16進64文字(32バイト)。
# 例の値は使わず、`openssl rand -hex 32` などで生成すること。
# PHARMACY_SYNC_HUB_ENCRYPTION_KEY=<openssl rand -hex 32 で生成>
PHARMACY_SYNC_HUB_ENCRYPTION_KEY=
# 接続先: 同一端末のlocalhostはHTTP可。施設内LANはHTTPS必須
# (HTTPしか使えないLANでは下のTRANSPORT暗号化を設定した場合のみ許可)。
# 端末IDとトークンはメイン端末の「設定 > 端末同期」で発行して転記する。
PHARMACY_SYNC_TRANSPORT_ENCRYPTION=none
# LANがHTTPの場合のみ: 共有施設鍵でペイロードをAES-256-GCM暗号化する(hub側にも同じ設定が必要)。
# PHARMACY_SYNC_TRANSPORT_ENCRYPTION=aes-gcm
# PHARMACY_SYNC_TRANSPORT_KEY=<openssl rand -hex 32 で生成(全端末で同じ値)>
PHARMACY_SYNC_TRANSPORT_KEY=
